{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gruuvix-ai-router",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "LOG_LEVEL": "info",
    // Debug headers (x-gruuvix-provider / x-gruuvix-attempts / x-gruuvix-request-id).
    // Never enable on production unless explicitly needed: reveals internal providers.
    "ROUTER_DEBUG_HEADERS": "false",
    // Upper bound on upstream attempts per client request (bounded further by
    // number of enabled providers). "3" is a safe initial default.
    "MAX_PROVIDER_ATTEMPTS": "3",
    // Lease TTL: how long an acquire() lease counts toward provider concurrency
    // if the Worker never reports back (crash safety). Must comfortably exceed
    // the longest streaming generation.
    "LEASE_TTL_MS": "600000",
    // Injected upstream when the client does not send reasoning_effort itself.
    // Gruuvix workload is sentence summarization → low. Client value always wins.
    "DEFAULT_REASONING_EFFORT": "low"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "AI_ROUTER",
        "class_name": "AiRouterCoordinator"
      }
    ]
  },

  // Usage ledger (D1) is bound ONLY in env.production — see env block below.
  // Tests/local dev run without it: the recorder is a no-op when the binding is absent.

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AiRouterCoordinator"]
    }
  ],

  // Deployed environments. Secrets live in the account-level Secrets Store
  // (Workers > Secrets Store, store "default_secrets_store"); the default (local
  // dev / tests) environment instead uses plain bindings from .dev.vars.
  "env": {
    "production": {
      "name": "gruuvix-ai-router",
      // NOTE: wrangler environments do not inherit vars or bindings — a production
      // env must redeclare everything it needs.
      "vars": {
        "LOG_LEVEL": "info",
        "ROUTER_DEBUG_HEADERS": "false",
        "MAX_PROVIDER_ATTEMPTS": "3",
        "LEASE_TTL_MS": "600000",
        "DEFAULT_REASONING_EFFORT": "low"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AI_ROUTER",
            "class_name": "AiRouterCoordinator"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "USAGE_DB",
          "database_name": "gruuvix-usage",
          "database_id": "3e7ac2aa-947a-48c7-a096-2994b6a6c530"
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "GRUVIX_AI_ROUTER_KEY",
          "store_id": "373597b9faeb44839583e3ad2d05801a",
          "secret_name": "GRUVIX_AI_ROUTER_KEY"
        },
        {
          "binding": "GRUVIX_AI_ROUTER_ADMIN_KEY",
          "store_id": "373597b9faeb44839583e3ad2d05801a",
          "secret_name": "GRUVIX_AI_ROUTER_ADMIN_KEY"
        },
        {
          "binding": "DEEPINFRA_API_KEY",
          "store_id": "373597b9faeb44839583e3ad2d05801a",
          "secret_name": "DEEPINFRA_API_KEY"
        },
        {
          "binding": "AKASHML_API_KEY",
          "store_id": "373597b9faeb44839583e3ad2d05801a",
          "secret_name": "AKASHML_API_KEY"
        },
        {
          "binding": "CRUSOE_API_KEY",
          "store_id": "373597b9faeb44839583e3ad2d05801a",
          "secret_name": "CRUSOE_API_KEY"
        },
        {
          "binding": "NOVITA_API_KEY",
          "store_id": "373597b9faeb44839583e3ad2d05801a",
          "secret_name": "NOVITA_API_KEY"
        },
        {
          "binding": "MODAL_BASE_URL",
          "store_id": "373597b9faeb44839583e3ad2d05801a",
          "secret_name": "MODAL_BASE_URL"
        },
        {
          "binding": "MODAL_API_KEY",
          "store_id": "373597b9faeb44839583e3ad2d05801a",
          "secret_name": "MODAL_API_KEY"
        }
      ]
    }
  },

  // Secrets (set with `wrangler secret put <NAME>`):
  //   GRUVIX_AI_ROUTER_KEY       - bearer key Gruuvix uses against this router
  //   GRUVIX_AI_ROUTER_ADMIN_KEY - bearer key for /internal/* admin routes
  //   DEEPINFRA_API_KEY          - upstream key for DeepInfra
  //   AKASHML_API_KEY            - upstream key for AkashML
  //   MODAL_BASE_URL             - URL of the EXISTING Modal GPT-OSS-120B endpoint (not a secret, but env-managed)
  //   MODAL_API_KEY              - optional; only if the Modal endpoint enforces auth
}
